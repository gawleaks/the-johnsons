{
  "name": "the-johnsons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "the-johnsons": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const {cpSync, copyFileSync} = require('node:fs'); cpSync('test/helpers', 'dist/test/helpers', { recursive: true }); copyFileSync('package.json', 'dist/package.json');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
